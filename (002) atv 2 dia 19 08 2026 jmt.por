programa
{
	
	funcao inicio()
	{
		cadeia nome
		nome = "Sábio Sérgio"
		real nota1
		nota1 = 7.5
		real nota2
		nota2 = 10.0
		real nota3
		nota3 = 8.5

		cadeia valor
		valor = nome +"\n"+ nota1 +"\n"+ nota2 +"\n"+ nota3
		escreva(valor)
	}
}

