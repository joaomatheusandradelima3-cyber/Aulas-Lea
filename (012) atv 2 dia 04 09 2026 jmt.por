programa
{
	
	funcao inicio()
	{
		real val
		escreva("Digite um valor qualquer: ")
		leia(val)
		se(val >= 0)
		{
			escreva("Valor positivo")
		}
		senao
		{
			escreva("Valor niggativo")
		}
	}
}
