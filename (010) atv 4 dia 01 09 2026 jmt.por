programa
{
	
	funcao inicio()
	{
		real raio,pi,area
		escreva(" ██████╗██╗██████╗  ██████╗██╗   ██╗██╗      ██████╗ ████████╗██████╗  ██████╗ ███╗   ███╗\n██╔════╝██║██╔══██╗██╔════╝██║   ██║██║     ██╔═══██╗╚══██╔══╝██╔══██╗██╔═══██╗████╗ ████║\n██║     ██║██████╔╝██║     ██║   ██║██║     ██║   ██║   ██║   ██████╔╝██║   ██║██╔████╔██║\n██║     ██║██╔══██╗██║     ██║   ██║██║     ██║   ██║   ██║   ██╔══██╗██║   ██║██║╚██╔╝██║\n╚██████╗██║██║  ██║╚██████╗╚██████╔╝███████╗╚██████╔╝   ██║   ██║  ██║╚██████╔╝██║ ╚═╝ ██║\n ╚═════╝╚═╝╚═╝  ╚═╝ ╚═════╝ ╚═════╝ ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝ ╚═════╝ ╚═╝     ╚═╝\n\n                         ██████╗  ██████╗  ██████╗ ███████╗\n                         ╚════██╗██╔═████╗██╔═████╗╚════██║\n                          █████╔╝██║██╔██║██║██╔██║    ██╔╝\n                         ██╔═══╝ ████╔╝██║████╔╝██║   ██╔╝\n                         ███████╗╚██████╔╝╚██████╔╝   ██║\n                         ╚══════╝ ╚═════╝  ╚═════╝    ╚═╝\n\n")
		escreva("\n--------------------------------------------------------------------------------------------------------------\n")
		escreva("VALOR do Raio: ")
		leia(raio)
		pi = 3.14
		area = pi * ( raio * raio )
		escreva("Área do círculo é igual a: ",area,".")
		escreva("\n--------------------------------------------------------------------------------------------------------------\n")
		
	}
}
