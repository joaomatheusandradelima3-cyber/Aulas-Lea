programa
{
	
	funcao inicio()
	{
		cadeia nome
		real a,b,c
		escreva("Nome do burro: ")
		leia(nome)
		escreva("Nota bim. 1: ")
		leia(a)
		escreva("Nota bim. 2: ")
		leia(b)
		escreva("Nota bim. 3: ")
		leia(c)
		escreva("-----------------------------------------\n",nome,")
	}
}
