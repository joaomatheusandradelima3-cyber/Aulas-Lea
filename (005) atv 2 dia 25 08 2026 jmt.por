programa
{
	
	funcao inicio()
	{
		inteiro a,b
		escreva()
		escreva("Esreva 2 valores:")
		leia(a)
		leia(b)
		escreva("------------------------------------------------\n","\n Multiplicação: ",a * b,"\n Subtração: ",a - b,"\n Divisão: ",a / b)
	}
}

