programa
{
	
	funcao inicio()
	{
		inteiro a,b,soma
		escreva("Escreva um valor: ")
		leia(a)
		escreva("Escreva o segundo valor: ")
		leia(b)
		soma = a + b
		escreva("A soma de ",a," + ",b," é igual a ",soma)
	}
}
