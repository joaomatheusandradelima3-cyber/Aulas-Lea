programa
{
	
	funcao inicio()
	{
		escreva("████████╗██████╗ ██╗ █████╗ ███╗   ██╗ ██████╗ ██╗   ██╗██╗      ██████╗ ████████╗██████╗  ██████╗ ███╗   ███╗\n╚══██╔══╝██╔══██╗██║██╔══██╗████╗  ██║██╔════╝ ██║   ██║██║     ██╔═══██╗╚══██╔══╝██╔══██╗██╔═══██╗████╗ ████║\n   ██║   ██████╔╝██║███████║██╔██╗ ██║██║  ███╗██║   ██║██║     ██║   ██║   ██║   ██████╔╝██║   ██║██╔████╔██║\n   ██║   ██╔══██╗██║██╔══██║██║╚██╗██║██║   ██║██║   ██║██║     ██║   ██║   ██║   ██╔══██╗██║   ██║██║╚██╔╝██║\n   ██║   ██║  ██║██║██║  ██║██║ ╚████║╚██████╔╝╚██████╔╝███████╗╚██████╔╝   ██║   ██║  ██║╚██████╔╝██║ ╚═╝ ██║\n   ╚═╝   ╚═╝  ╚═╝╚═╝╚═╝  ╚═╝╚═╝  ╚═══╝ ╚═════╝  ╚═════╝ ╚══════╝ ╚═════╝    ╚═╝   ╚═╝  ╚═╝ ╚═════╝ ╚═╝     ╚═╝\n\n                              ██████╗  ██████╗  ██████╗ ███████╗\n                              ╚════██╗██╔═████╗██╔═████╗╚════██║\n                               █████╔╝██║██╔██║██║██╔██║    ██╔╝\n                              ██╔═══╝ ████╔╝██║████╔╝██║   ██╔╝\n                              ███████╗╚██████╔╝╚██████╔╝   ██║\n                              ╚══════╝ ╚═════╝  ╚═════╝    ╚═╝\n")
		real AREA,BASE,ALTURA
		escreva("--------------------------------------------------------------------------------------------------------------\n")
		escreva("medida da base: ")
		leia(BASE)
		escreva("medida da altura: ")
		leia(ALTURA)
		escreva("--------------------------------------------------------------------------------------------------------------\n")
		AREA = (BASE * ALTURA) / 2
		escreva("a ÁREA do triangulo é igual a: " + AREA + "." )
		
	
	}
}

