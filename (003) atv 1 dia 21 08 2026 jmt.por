programa
{
	
	funcao inicio()
	{
		cadeia nome
		real n1,n2,n3
		nome = "Cigarro"
		n1 = 5.9
		n2 = 6.7
		n3 = 9.9
		escreva("Nome do Aluno: ",nome,"\n")
		escreva("Notas: ","\n",n1,"\n",n2,"\n",n3)
	}
}
